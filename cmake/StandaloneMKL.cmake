# Optional, user-provided dependency only. No discovery when disabled.
option(TIMESTRAL_STANDALONE_MKL "Use qualified standalone MKL SDPA and F32 context patch addmm" OFF)
if(TIMESTRAL_STANDALONE_MKL)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$" OR CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "Standalone MKL supports native Linux x86_64 only")
  endif()
  set(TIMESTRAL_MKL_INCLUDE_DIR "" CACHE PATH "User MKL include directory")
  foreach(part LP64 SEQUENTIAL CORE)
    set(TIMESTRAL_MKL_${part}_LIBRARY "" CACHE FILEPATH "User shared MKL ${part} library")
    if(NOT EXISTS "${TIMESTRAL_MKL_${part}_LIBRARY}" OR NOT TIMESTRAL_MKL_${part}_LIBRARY MATCHES "libmkl_.*\\.so(\\.[0-9]+)*$")
      message(FATAL_ERROR "Explicit shared MKL ${part} library required")
    endif()
  endforeach()
  if(NOT EXISTS "${TIMESTRAL_MKL_INCLUDE_DIR}/mkl.h")
    message(FATAL_ERROR "Explicit MKL headers required")
  endif()
  foreach(pair "LP64;intel_lp64" "SEQUENTIAL;sequential" "CORE;core")
    list(GET pair 0 key)
    list(GET pair 1 name)
    if(NOT TIMESTRAL_MKL_${key}_LIBRARY MATCHES "libmkl_${name}\\.so(\\.[0-9]+)*$")
      message(FATAL_ERROR "MKL library does not match required ${key} identity")
    endif()
  endforeach()
  include(CheckCXXSourceCompiles)
  set(CMAKE_REQUIRED_INCLUDES "${TIMESTRAL_MKL_INCLUDE_DIR}")
  set(CMAKE_REQUIRED_LIBRARIES "${TIMESTRAL_MKL_LP64_LIBRARY};${TIMESTRAL_MKL_SEQUENTIAL_LIBRARY};${TIMESTRAL_MKL_CORE_LIBRARY};pthread;m;dl")
  unset(TIMESTRAL_MKL_LINKS CACHE)
  check_cxx_source_compiles("#include <mkl.h>\nstatic_assert(__INTEL_MKL__==2024 && __INTEL_MKL_MINOR__==0 && __INTEL_MKL_UPDATE__==2 && __INTEL_MKL_BUILD_DATE==20240605,\"Unsupported MKL headers\");\nstatic_assert(sizeof(MKL_INT)==4,\"LP64 required\");\nint main(){MKLVersion v;mkl_get_version(&v);float a=1,b=1,c=0;cblas_sgemm(CblasColMajor,CblasNoTrans,CblasNoTrans,1,1,1,1,&a,1,&b,1,0,&c,1);return 0;}" TIMESTRAL_MKL_LINKS)
  unset(CMAKE_REQUIRED_INCLUDES)
  unset(CMAKE_REQUIRED_LIBRARIES)
  if(NOT TIMESTRAL_MKL_LINKS)
    message(FATAL_ERROR "MKL LP64 SGEMM/version compile-link probe failed")
  endif()
  add_library(timestral-standalone-mkl INTERFACE)
  target_include_directories(timestral-standalone-mkl INTERFACE "${TIMESTRAL_MKL_INCLUDE_DIR}")
  target_link_libraries(timestral-standalone-mkl INTERFACE "-Wl,--no-as-needed" "${TIMESTRAL_MKL_LP64_LIBRARY}" "${TIMESTRAL_MKL_SEQUENTIAL_LIBRARY}" "${TIMESTRAL_MKL_CORE_LIBRARY}" "-Wl,--as-needed" pthread m dl)
endif()
